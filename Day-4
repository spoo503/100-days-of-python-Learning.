name = input("Enter the student name: ")
clg = input("Enter the college name: ")
Student_class = int(input("Enter the class: "))

classes = int(input("Enter the total number of classes: "))
Attended = int(input("Enter the number of classes attended: "))

percentage = (Attended / classes) * 100

if percentage >= 75:
    print("You can attend the exam")
    
    if percentage >= 85:
        print("You are eligible to attend the exam with good attendance")
    else:
        print("You can attend the exam")
else:
    print("You are detained from the examination")

print("Name:", name)
print("College:", clg)
print("Class:", Student_class)
print("Total Classes:", classes)
print("Classes Attended:", Attended)
print("Attendance Percentage:", percentage)

#PROBLEM 2
Name = input("Enter the name of customer: ")
Bank = input("Enter the bank 🏦 name: ")
Balance = int(input("Enter the balance amount: "))
amount = int(input("Enter the amount: "))
option = input("Enter the option (Balance / withdraw / Debit): ")

for i in range(3):
    pin = int(input("Enter the pin: "))

    if pin == 1234:
        print("Correct pin")

        if option == "Balance":
            print("Total amount is", Balance)

        elif option == "withdraw":
            print("Amount left is", Balance - amount)

        elif option == "Debit":
            print("Amount added to account is", Balance + amount)

        break

    else:
        print("Incorrect pin")

print("Welcome to", Bank)
print("Name:", Name)
print("Bank:", Bank)
print("Amount:", amount)
print("Balance:", Balance)
print("Option:", option)
