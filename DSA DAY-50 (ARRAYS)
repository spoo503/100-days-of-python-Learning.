def linear_search(a,key):
    for i in range(len(a)):
        if a[i]==key:
            return i
    return -1
def main():
    a=[1,2,3,4]
    key=4
    print(linear_search(a,key))

if __name__ =='__main__':
    main()

##SPAN OF ARRAY###
def span_array(a):
    max=a[0]
    min=a[0]
    for i in range(0,len(a)):
        if a[i]>max:
            max=a[i]
        if a[i]<min:
            min=a[i]
    return max-min
def main():
    a=[1,2,3,4,5]
    print(span_array(a))
if __name__=='__main__':
    main()

###BINARY SEARCH###
def binary_search(a,key):
    l,h,mid=0,len(a)-1,0
    while(l<=h):
        mid=(l+h)//2
        if key==a[mid]:
            return mid
        elif key<a[mid]:
            h=mid-1
            #l=l
        else:
            l=mid+1
            #h=h
def main():
    a=[1,2,3,4]
