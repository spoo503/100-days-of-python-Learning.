    max1,max2=0,0
    if a[0]>a[1]:
        max1,max2=a[0],a[1]
    else :
        max1,max2=a[0],a[1]
    for i in range(2,len(a)):
        if a[i]>max1:
            max2=max1
            max1=a[i]
        elif a[i]>max2:
            max2=a[i]
    return max2 
