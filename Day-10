##problem 2.
print("WELCOME TO THE COLLEGE CLUB REGISTRATION")

n = int(input("Enter the number of students participating in the event: "))

coding_count = 0

for i in range(n):
    Name = input("Enter the student name: ")
    club_no = int(input("Enter the number of clubs you want to join in the event: "))

    club_name = input("Enter the club names you want to join: ").split()

    Zone = {"NAME": Name, "CLUB": club_name}
    print(Zone)

    if club_no >= 2:
        print("You are eligible for club badge")

    if "Coding" in club_name:
        coding_count += 1

print("Total number of students participating in the event is", n)
print("Total number of people who joined Coding club are", coding_count)
