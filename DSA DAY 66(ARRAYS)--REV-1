class Solution:
    def remove_adjacent_duplicates(self, arr):
        s = [arr[0]]                    # keep first element, no comparison needed
        for i in range(1, len(arr)):
            if arr[i] != arr[i-1]:
                s.append(arr[i])
        return s

s = Solution()
print(s.remove_adjacent_duplicates([3, 3, 7, 7, 7, 2, 9, 9]))  
# [3, 7, 2, 9]

print(s.remove_adjacent_duplicates([5, 2, 8, 5]))
# [5, 2, 8, 5]  <-- both 5's kept, since they're not adjacent


B.class Solution:
    def remove_duplicates_anywhere(self, arr):
        seen = set()
        s = []
        for i in range(0, len(arr)):
            if arr[i] not in seen:
                s.append(arr[i])
                seen.add(arr[i])
        return s

s = Solution()
print(s.remove_duplicates_anywhere([3, 3, 7, 7, 7, 2, 9, 9]))
# [3, 7, 2, 9]

