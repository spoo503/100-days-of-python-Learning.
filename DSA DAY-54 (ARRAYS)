CASE-2:
IF AN ARRAY=[1,2,2,2,4,5]
*DUPLICANTS ARE PRESENT
*DO BINARY SEARCH
*CHECK FOR DUPLICANTS 
class Solution:
    def array(self, a, target):
        l = 0
        h = len(a) - 1

        while l <= h:
            m = (l + h) // 2

            if a[m] == target:

                left = m
                while left > 0 and a[left - 1] == target:
                    left -= 1

                right = m
                while right < len(a) - 1 and a[right + 1] == target:
                    right += 1

                count = right - left + 1

                return left, right, count

            elif target < a[m]:
                h = m - 1

            else:
                l = m + 1

        return -1


