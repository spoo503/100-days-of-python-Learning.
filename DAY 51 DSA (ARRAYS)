def bitonic_find(a):
    l,r,m=0,len(a)-1,0
    while l<=r:
        m=(l+r)//2
        if a[m]>a[m+1] and a[m]>a[m-1]:
            return m
        elif a[m]>a[m+1] and a[m]<a[m-1]:
            l=m+1
        else:
            r=m-1
def main():
    a=[12,334,566,500,200,20]
    print(bitonic_find(a))
if __name__=='__main__':
    main()
