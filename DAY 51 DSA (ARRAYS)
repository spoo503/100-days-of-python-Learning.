####BINARY SEARCH###
def binary_search(a,key):
    l,h,mid=0,len(a)-1,0
    while(l<=h):
        mid=(l+h)//2
        if key==a[mid]:
            return mid
        elif key<a[mid]:
            h=mid-1
            #l=l
        else:
            l=mid+1
            #h=h
def main():
    a=[1,2,3,4]
    key=3
    print(binary_search(a,key))
if __name__=='__main__':
    main()

##SECONDLARGEST ELEMENT###
def second_largest(a):
    max1,max2=0,0
    if a[0]>a[1]:
        max1,max2=a[0],a[1]
    else :
        max1,max2=a[0],a[1]
    for i in range(2,len(a)):
        if a[i]>max1:
            max2=max1
            max1=a[i]
        elif a[i]>max2:
            max2=a[i]
    return max2 
def main():
    a=[23,42,3,3]
    print(second_largest(a))
if __name__=='__main__':
    main()
