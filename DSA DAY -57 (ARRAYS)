def max_page(arr,b):
    if b>len(arr):   # if number of the students are and number of books are less then return False.
        return -1
    l=arr[0]        #assuming the l is equal to aray of zero it is least number of pages
    h=0
    for  i in arr:
            if i>l:   # if if it is greater than of array of zero so replace the element.
                l=i
            h=h+i
    res=-1
    while(l<=h):
        m=(l+h)//2
        if is_possible_sol(arr,b,m)==True:   # if  that is true then res=m,h=m-1
            res=m
            h=m-1
        else:
            l=m+1
    return res 
