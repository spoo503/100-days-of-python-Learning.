_______________MOVE ZEROS TO LAST_________________________|
# we need to move the zeros of eleemnts in the array without copying #and using extra space.
class Solution:
    def move_zeros(self,arr):
        size=len(arr)
        if (size==0 or size==1):
            return arr
        nz=0
        z=0
        while(nz<size):
            if arr[nz]!=0:
                arr[nz],arr[z]=arr[z],arr[nz]
                nz+=1
                z+=1
            else:
                nz+=1
        return arr
s=Solution()
print(s.move_zeros([0,10,22,8,0,5,0]))


