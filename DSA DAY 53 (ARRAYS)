------------------------------BITONIC ARRAY-----------------------------------------------------------------------------------------
def bitonic_find(a):
    l,r,m=0,len(a)-1,0
    while l<=r:
        m=(l+r)//2
        if a[m]>a[m+1] and a[m]>a[m-1]:
            return m
        elif a[m]>a[m+1] and a[m]<a[m-1]:
            l=m+1
        else:
            r=m-1
def main():
    a=[12,334,566,500,200,20]
    print(bitonic_find(a))
if __name__=='__main__':
    main()
------------------------------------------ASCENDING BINARY SEARCH--------------------------------------------------------------------------
class Solution:
    def search(self, nums, target):
        l = 0
        h = len(nums) - 1

        while l <= h:
            mid = (l + h) // 2

            if nums[mid] == target:
                return mid

            elif target < nums[mid]:
                h = mid - 1

            else:
                l = mid + 1

        return -1
