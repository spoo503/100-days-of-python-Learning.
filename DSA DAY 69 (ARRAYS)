#LET US CONSIDER ARRAY AS [1,0,2,1,0]
class Solution:
    def sort_array(self,arr):
        n=len(arr)
        count_0=0
        count_1=0
        count_2=0
        for i in range(n):
            for j in range(0,n-i-1):
                if arr[j]>arr[j+1]:
                    arr[j],arr[j+1]=arr[j+1],arr[j]
        for i in range(0,len(arr)):
            if arr[i]==0:
                count_0+=1
        for i in range(0,len(arr)):
            if arr[i]==1:
                count_1+=1
        for i in range(0,len(arr)):
            if arr[i]==2:
                count_2+=1
        return arr ,count_0,count_1,count_2
