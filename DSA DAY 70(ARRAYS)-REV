12. Given an array of n-1 numbers from 1 to n with one missing, find the missing number — solve it 3 ways:
sum formula, XOR, and by using an extra hash array.
class Solution:
    # Approach 1: Sum formula
    def missing_number_sum(self, arr, n):
        expected_sum = n * (n + 1) // 2
        actual_sum = sum(arr)
        return expected_sum - actual_sum

    # Approach 2: XOR
    def missing_number_xor(self, arr, n):
        xor_all = 0
        for i in range(1, n + 1):
            xor_all ^= i          # XOR all numbers from 1 to n

        xor_arr = 0
        for num in arr:
            xor_arr ^= num        # XOR all numbers actually present

        return xor_all ^ xor_arr  # whatever's left is the missing number

    # Approach 3: Hash array
    def missing_number_hash(self, arr, n):
        seen = [False] * (n + 1)   # index 0 unused, indices 1..n represent numbers 1..n
        for num in arr:
            seen[num] = True

        for i in range(1, n + 1):
            if not seen[i]:
                return i


s = Solution()
arr = [1, 2, 4, 5]
n = 5

print(s.missing_number_sum(arr, n))   # 3
print(s.missing_number_xor(arr, n))   # 3
print(s.missing_number_hash(arr, n))  # 3
