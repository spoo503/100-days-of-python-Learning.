8. Move all zeros to the end while keeping the relative order of non-zero elements, in-place.
class Solution:
    def move_zeroes(self,arr):
        l=[] 
        for i in range(0,len(arr)):
            if arr[i]!=0:
                l.append(arr[i])
        while len(l)<len(arr):
            l.append(0)
        return l
s=Solution()
print(s.move_zeroes[0,10,10,0,0])
