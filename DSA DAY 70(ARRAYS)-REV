4.Check if an array is sorted and rotated — e.g. [3,4,5,1,2] should count as sorted-rotated. Handle at most one "break point."
class Solution:
    def check_sorted_and_rotated(self, arr):
        n = len(arr)
        count = 0  # counts how many "drop" points we find

        for i in range(1, n):
            if arr[i] < arr[i - 1]:
                count += 1

        # circular check: compare last element back to first element
        if arr[n - 1] > arr[0]:
            count += 1

        return count <= 1


s = Solution()
print(s.check_sorted_and_rotated([3, 4, 5, 1, 2]))  # True
print(s.check_sorted_and_rotated([2, 1, 3, 4, 5]))  # False
print(s.check_sorted_and_rotated([1, 2, 3]))        # True (already sorted, 0 rotation)
print(s.check_sorted_and_rotated([2, 1]))            # True (rotated by 1)
